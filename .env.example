# Ambiente locale: copiare come .env e poi eseguire `php artisan key:generate`.
APP_NAME=WAYOUT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
BCRYPT_ROUNDS=12

LOG_CHANNEL=application
LOG_STACK=application
LOG_LEVEL=debug
LOG_DAILY_DAYS=30
LOG_TIMEZONE=Europe/Rome
SCHEDULE_LOG_LEVEL=error
SCHEDULE_LOG_DAYS=30

# MySQL locale. Creare prima il database `wayout_website` con utf8mb4.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wayout_website
DB_USERNAME=wayout_local
DB_PASSWORD=change-me-local
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Configurazione sicura in sviluppo: le email restano nei log.
EMAIL_SENDING_ENABLED=true
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_LOG_CHANNEL=email
EMAIL_LOG_LEVEL=info
EMAIL_LOG_DAYS=30
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=local@wayout.test
MAIL_FROM_NAME=WAYOUT
MAIL_REPLY_TO_ADDRESS=local@wayout.test
MAIL_REPLY_TO_NAME=WAYOUT
CONTACT_EMAIL=local@wayout.test

ADMIN_EMAIL=admin@wayout.test
# Inserire un hash bcrypt/Argon, non una password in chiaro.
ADMIN_PASSWORD=
ADMIN_MAX_USERS=4
ADMIN_OTP_ISSUER="WAYOUT Admin Local"

# Canale sito Laravel -> backend WAYOUT. Deve coincidere con INTERNAL_API_SECRET
# nell'ambiente backend corrispondente e contenere almeno 32 caratteri casuali.
WAYOUT_BASE_URL=https://staging-app.wayoutapp.it
WAYOUT_INTERNAL_SECRET=
WAYOUT_CONNECT_TIMEOUT=5
WAYOUT_TIMEOUT=15
WAYOUT_CATALOG_CACHE_SECONDS=60

# Configurazione web pubblica Firebase (mai inserire qui service account o chiavi private).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_SMS_RESEND_COOLDOWN_SECONDS=60

# reCAPTCHA v3 per i form pubblici. Creare chiavi v3 per i domini autorizzati.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MINIMUM_SCORE=0.5
RECAPTCHA_TIMEOUT=5

QONTO_INVOICING_ENABLED=false
QONTO_ENVIRONMENT=sandbox
QONTO_BASE_URL=https://thirdparty-sandbox.staging.qonto.co
QONTO_AUTH_METHOD=api_key
QONTO_LOGIN=
QONTO_SECRET_KEY=
QONTO_ACCESS_TOKEN=
QONTO_STAGING_TOKEN=
QONTO_ATTACHMENT_HOSTS=qonto.com,amazonaws.com
QONTO_INVOICE_IBAN=
QONTO_INVOICE_VAT_RATE=0.22
QONTO_INVOICE_PAYMENT_CONDITIONS=TP02
QONTO_INVOICE_PAYMENT_METHOD=MP08

WAITLIST_MAGIC_LINK_MINUTES=30
WAITLIST_VERIFICATION_RESEND_SECONDS=60
BENEFIT_API_DEFAULT_PER_PAGE=100
BENEFIT_API_MAX_PER_PAGE=200
BENEFIT_API_KEY=wayout-local-app
BENEFIT_API_SECRET=replace-with-at-least-32-random-characters
BENEFIT_API_MAX_CLOCK_SKEW_SECONDS=300

ANALYTICS_ENABLED=false
ANALYTICS_CONSENT_VERSION=1
ANALYTICS_CONSENT_DAYS=180
ANALYTICS_GTM_ID=
ANALYTICS_GA4_ID=
ANALYTICS_META_PIXEL_ID=
ANALYTICS_DEBUG=true

SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=false
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
TRUSTED_HOSTS=
